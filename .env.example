# Copy this file to ".env" in the project root (same folder as this file).
# Everything here is optional - the defaults work for local use.
# No API key is needed: the app uses built-in Python rules, not AI.

# --- Limits ---
MAX_UPLOAD_MB=25
MAX_UNCOMPRESSED_MB=300
MAX_ROWS=200000
MAX_COLUMNS=500
MAX_CELLS=2000000
MAX_SHEETS=50
MAX_PROCESSING_SECONDS=60

# --- Temporary files ---
JOB_TTL_MINUTES=30
MAX_ACTIVE_JOBS=50

# --- Browser access (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
